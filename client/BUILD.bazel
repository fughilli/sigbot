load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_wheel")

package(default_visibility = ["//visibility:public"])

# In-repo target for the wheel's package; bazel-module consumers depend on
# this directly (@signal_ai_bot//client:sigbot_client_lib).
py_library(
    name = "sigbot_client_lib",
    srcs = ["sigbot_client/__init__.py"],
    imports = ["."],
)

# The installable artifact:  bazel build //client:sigbot_client_wheel
# This py_wheel is the package's single source of metadata — CI publishes it
# to PyPI and the release page. scripts/check_client_version.py keeps the
# version in sync with sigbot_client.__version__ and the release tags.
py_wheel(
    name = "sigbot_client_wheel",
    description_content_type = "text/markdown",
    description_file = "README.md",
    distribution = "sigbot-client",
    license = "MIT",
    project_urls = {
        "Homepage": "https://github.com/fughilli/sigbot",
        "Source": "https://github.com/fughilli/sigbot",
    },
    python_requires = ">=3.9",
    python_tag = "py3",
    strip_path_prefixes = ["client"],
    summary = "Client for the sigbot per-group-chat service API (stdlib-only)",
    version = "0.3.0",
    deps = [":sigbot_client_lib"],
)
