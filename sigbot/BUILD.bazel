load("@aspect_bazel_lib//lib:tar.bzl", "mtree_spec", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "sigbot_lib",
    srcs = glob(["*.py"], exclude = ["main.py", "admin_cli.py"]),
    data = glob(["static/*.html"]),
    deps = [
        "@sigbot_pypi//aiohttp",
        "@sigbot_pypi//anthropic",
        "@sigbot_pypi//httpx",
        "@sigbot_pypi//pyyaml",
        "@sigbot_pypi//websockets",
    ],
)

py_binary(
    name = "sigbot_server",
    srcs = ["main.py"],
    main = "main.py",
    deps = [":sigbot_lib"],
)

py_binary(
    name = "admin",
    srcs = ["admin_cli.py"],
    main = "admin_cli.py",
    deps = [":sigbot_lib"],
)

# -- container image -----------------------------------------------------------
# Self-contained stack: the upstream signal-cli-rest-api image as the base,
# plus sigbot (server + admin CLI, full runfiles, hermetic python) and a
# supervisor entrypoint that runs both processes.

mtree_spec(
    name = "app_mtree",
    srcs = [
        ":admin",
        ":sigbot_server",
    ],
)

tar(
    name = "app_tar",
    srcs = [
        ":admin",
        ":sigbot_server",
    ],
    mtree = ":app_mtree",
)

tar(
    name = "entrypoint_tar",
    srcs = ["container/entrypoint.sh"],
    mtree = [
        "sigbot-entrypoint.sh type=file mode=0755 content=$(location container/entrypoint.sh)",
    ],
)

# The base image has no python3, which py_binary's stage-1 bootstrap needs;
# point it at the hermetic interpreter already shipped in the runfiles.
# (One tar per arch — select() lives on oci_image.tars, since tar's mtree
# attribute doesn't accept a select.)
_PY_RUNFILES = "/sigbot/sigbot_server.runfiles/rules_python~~python~python_3_12_{arch}-unknown-linux-gnu/bin/python3"

[
    tar(
        name = "python_link_tar_" + arch,
        mtree = ["usr/bin/python3 type=link link=" + _PY_RUNFILES.format(arch = arch)],
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
]

oci_image(
    name = "image",
    base = "@signal_api_base",
    entrypoint = ["/sigbot-entrypoint.sh"],
    exposed_ports = [
        "8080",  # signal-cli-rest-api (account provisioning; keep loopback-only)
        "8100",  # sigbot service API + dashboard
    ],
    tars = [
        ":app_tar",
        ":entrypoint_tar",
    ] + select({
        "@platforms//cpu:aarch64": [":python_link_tar_aarch64"],
        "@platforms//cpu:x86_64": [":python_link_tar_x86_64"],
    }),
    visibility = ["//visibility:public"],
    workdir = "/data",
)

# Dev path (docker required):  bazel run //sigbot:image_load
#   then:  docker run --rm -v "$PWD/data:/data" -p 8100:8100 sigbot:latest
oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["sigbot:latest"],
)

# CI pushes per-arch tags; a manifest job stitches them into :latest.
oci_push(
    name = "image_push",
    image = ":image",
    repository = "ghcr.io/fughilli/sigbot",
)
