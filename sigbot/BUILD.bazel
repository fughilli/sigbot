load("@aspect_bazel_lib//lib:tar.bzl", "mtree_spec", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "sigbot_lib",
    srcs = glob(["*.py"], exclude = ["main.py", "admin_cli.py"]),
    data = glob(["static/*.html"]),
    deps = [
        "@sigbot_pypi//aiohttp",
        "@sigbot_pypi//anthropic",
        "@sigbot_pypi//httpx",
        "@sigbot_pypi//pyyaml",
        "@sigbot_pypi//websockets",
    ],
)

py_binary(
    name = "sigbot_server",
    srcs = ["main.py"],
    main = "main.py",
    deps = [":sigbot_lib"],
)

py_binary(
    name = "admin",
    srcs = ["admin_cli.py"],
    main = "admin_cli.py",
    deps = [":sigbot_lib"],
)

# -- container image -----------------------------------------------------------
# Self-contained stack: the upstream signal-cli-rest-api image as the base,
# plus sigbot (server + admin CLI, full runfiles, hermetic python) and a
# supervisor entrypoint that runs both processes.

mtree_spec(
    name = "app_mtree",
    srcs = [
        ":admin",
        ":sigbot_server",
    ],
)

tar(
    name = "app_tar",
    srcs = [
        ":admin",
        ":sigbot_server",
    ],
    mtree = ":app_mtree",
)

tar(
    name = "entrypoint_tar",
    srcs = ["container/entrypoint.sh"],
    mtree = [
        "sigbot-entrypoint.sh type=file mode=0755 content=$(location container/entrypoint.sh)",
    ],
)

# NOTE: never ship a /usr/bin/python3 layer here. The base image's own
# python3 runs its supervisord (which manages signal-cli-rest-api); shadowing
# it with the hermetic interpreter breaks the whole stack. py_binary's
# stage-1 bootstrap (#!/usr/bin/env python3) happily uses the base's python3
# and then re-execs the hermetic interpreter from the runfiles.
oci_image(
    name = "image",
    base = "@signal_api_base",
    entrypoint = ["/sigbot-entrypoint.sh"],
    exposed_ports = [
        "8080",  # signal-cli-rest-api (account provisioning; keep loopback-only)
        "8100",  # sigbot service API + dashboard
    ],
    tars = [
        ":app_tar",
        ":entrypoint_tar",
    ],
    visibility = ["//visibility:public"],
    workdir = "/data",
)

# Dev path (docker required):  bazel run //sigbot:image_load
#   then:  docker run --rm -v "$PWD/data:/data" -p 8100:8100 sigbot:latest
oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["sigbot:latest"],
)

# CI pushes per-arch tags; a manifest job stitches them into :latest.
oci_push(
    name = "image_push",
    image = ":image",
    repository = "ghcr.io/fughilli/sigbot",
)
