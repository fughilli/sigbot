module(
    name = "sigbot",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_python", version = "2.0.3")
bazel_dep(name = "rules_uv", version = "0.86.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# rules_nixpkgs lets Bazel import Nix-built packages as Bazel targets. Register
# the module (pinned) so the option exists — but DO NOT declare a `nix_repo` /
# `nixpkgs_package` here. Declaring one makes Bazel evaluate Nix at fetch time,
# which FAILS on machines without `nix` and breaks the build for everyone.
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")

PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "sigbot_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "sigbot_pypi")

# Base image for //sigbot:image: upstream signal-cli-rest-api (signal-cli,
# JRE, per-arch libsignal all solved there). Our entrypoint supervises the
# upstream /entrypoint.sh plus sigbot_server, so one container runs the whole
# stack. Keep the tag in lockstep with docker-compose.yml and flake.nix.
# python is NOT guaranteed in this base — py_binary uses the bash
# bootstrap_impl=script (.bazelrc) with the hermetic runfiles interpreter.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "signal_api_base",
    # bbernhard/signal-cli-rest-api:0.100
    digest = "sha256:2399d449123cdad56c4d859277e3b9127e1a00c4d2ab4601c239882609286cf8",
    image = "docker.io/bbernhard/signal-cli-rest-api",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "signal_api_base", "signal_api_base_linux_amd64", "signal_api_base_linux_arm64_v8")
